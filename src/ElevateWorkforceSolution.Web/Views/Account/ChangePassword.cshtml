@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Change password";
}

<div class="page">
    <div class="container" style="max-width:560px">
        <div class="page-header">
            <h1>Change password</h1>
            <p>Choose a password you do not use for any other service.</p>
        </div>

        <div class="card card-pad">
            <form asp-controller="Account" asp-action="ChangePassword" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                <div class="field">
                    <label asp-for="CurrentPassword" class="form-label"></label>
                    <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" />
                    <span asp-validation-for="CurrentPassword" class="field-validation-error"></span>
                </div>

                <div class="field">
                    <label asp-for="NewPassword" class="form-label"></label>
                    <input asp-for="NewPassword" class="form-control" autocomplete="new-password" id="Password" />
                    <span id="password-hint" class="form-text">Use at least 8 characters with upper case, lower case, a number and a symbol.</span>
                    <span asp-validation-for="NewPassword" class="field-validation-error"></span>
                </div>

                <div class="field">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
                </div>

                <div class="row">
                    <button type="submit" class="btn btn-primary">Update password</button>
                    <a asp-controller="Account" asp-action="Profile" class="btn btn-outline">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
