@model AccountProfileViewModel
@{
    ViewData["Title"] = "Account settings";
}

<div class="page">
    <div class="container" style="max-width:720px">
        <div class="page-header">
            <h1>Account settings</h1>
            <p>Update the name, email address and phone number attached to your account.</p>
        </div>

        <div class="card">
            <div class="card-header"><h2>Your details</h2></div>
            <div class="card-body">
                <form asp-controller="Account" asp-action="Profile" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                    <div class="field-row field-row-2">
                        <div class="field">
                            <label asp-for="FirstName" class="form-label"></label>
                            <input asp-for="FirstName" class="form-control" autocomplete="given-name" />
                            <span asp-validation-for="FirstName" class="field-validation-error"></span>
                        </div>
                        <div class="field">
                            <label asp-for="LastName" class="form-label"></label>
                            <input asp-for="LastName" class="form-control" autocomplete="family-name" />
                            <span asp-validation-for="LastName" class="field-validation-error"></span>
                        </div>
                    </div>

                    <div class="field-row field-row-2">
                        <div class="field">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" autocomplete="email" />
                            <span asp-validation-for="Email" class="field-validation-error"></span>
                        </div>
                        <div class="field">
                            <label asp-for="PhoneNumber" class="form-label"></label>
                            <input asp-for="PhoneNumber" class="form-control" autocomplete="tel" />
                            <span asp-validation-for="PhoneNumber" class="field-validation-error"></span>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary">Save changes</button>
                </form>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-header"><h2>Password</h2></div>
            <div class="card-body">
                <p class="text-muted">Changing your password signs out your other devices.</p>
                <a asp-controller="Account" asp-action="ChangePassword" class="btn btn-outline">Change password</a>
            </div>
        </div>
    </div>
</div>
