@model AdminApplicationsViewModel
@{ ViewData["Title"] = "Applications"; }
<div class="page"><div class="container"><h1>Applications</h1><form method="get" asp-action="Applications" class="row g-2 mb-3"><div class="col-md-4"><input asp-for="Keyword" class="form-control" placeholder="Search candidate or job" /></div><div class="col-md-4"><select asp-for="Status" asp-items="Model.StatusOptions" class="form-select"></select></div><div class="col-md-4"><button class="btn btn-outline w-100" type="submit">Filter</button></div></form>@if(Model.Results.Items.Count==0){<div class="card"><div class="card-body text-muted">No applications match.</div></div>}{else{<div class="card table-wrap"><table class="table"><thead><tr><th>Job</th><th>Company</th><th>Status</th><th>Applied</th></tr></thead><tbody>@foreach(var a in Model.Results.Items){<tr><td><strong>@a.JobTitle</strong><div class="text-sm text-muted">Application #@a.Id</div></td><td>@a.CompanyName</td><td><span class="badge @a.Status.CssClass()">@a.StatusLabel</span></td><td>@a.AppliedDate.ToString("dd MMM yyyy")</td></tr>}</tbody></table></div>}</div></div>
