@model AdminCompaniesViewModel
@{ ViewData["Title"] = "Companies"; }
<div class="page"><div class="container"><h1>Companies</h1><form method="get" asp-action="Companies" class="mb-3"><div class="input-group"><input asp-for="Keyword" class="form-control" placeholder="Search company" /><button class="btn btn-primary" type="submit">Search</button></div></form>@if(Model.Results.Items.Count==0){<div class="card"><div class="card-body text-muted">No companies match.</div></div>}{else{<div class="card table-wrap"><table class="table"><thead><tr><th>Company</th><th>Industry</th><th>Location</th><th>Active vacancies</th></tr></thead><tbody>@foreach(var c in Model.Results.Items){<tr><td><strong>@c.Name</strong><div class="text-sm text-muted">@c.ContactEmail</div></td><td>@c.Industry</td><td>@c.Location</td><td>@c.ActiveVacancyCount</td></tr>}</tbody></table></div>}</div></div>
