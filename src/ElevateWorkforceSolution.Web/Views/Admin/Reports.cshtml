@model AdminReportsViewModel
@{ ViewData["Title"] = "Platform reports"; }
<div class="page"><div class="container"><h1>Platform reports</h1><div class="grid grid-4 mb-3"><div class="card stat-card"><div class="stat-value">@Model.Report.TotalApplications</div><div class="stat-label">Applications</div></div><div class="card stat-card"><div class="stat-value">@Model.Report.TotalVacancies</div><div class="stat-label">Vacancies</div></div><div class="card stat-card"><div class="stat-value">@Model.Report.ApplicationsPerVacancy</div><div class="stat-label">Applications per vacancy</div></div><div class="card stat-card"><div class="stat-value">@Model.Report.ApplicationToShortlistRate%</div><div class="stat-label">Application-to-shortlist rate</div></div></div><div class="card card-pad"><h2 class="h5">Applications by status</h2><div class="stack-sm">@foreach(var item in Model.Report.ApplicationsByStatus){<div class="d-flex justify-content-between"><span>@item.Label</span><strong>@item.Count</strong></div>}</div></div></div></div>
