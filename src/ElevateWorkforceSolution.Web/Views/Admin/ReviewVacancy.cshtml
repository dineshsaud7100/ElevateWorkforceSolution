@model AdminVacancyReviewViewModel
@{ ViewData["Title"] = "Review vacancy"; var v=Model.Vacancy; }
<div class="page"><div class="container"><a asp-action="Vacancies" class="btn btn-outline btn-sm">Back to moderation queue</a><h1 class="mt-3">@v.Title</h1><p class="text-muted">@v.CompanyName · @v.EmployerName · @v.Status</p><div class="card card-pad mt-3"><h2 class="h5">Vacancy details</h2><div class="row g-3"><div class="col-md-6"><p><strong>Location:</strong> @v.WorkLocation</p><p><strong>Category:</strong> @v.Category</p><p><strong>Type:</strong> @v.JobType</p></div><div class="col-md-6"><p><strong>Salary:</strong> @v.SalaryMin-@v.SalaryMax</p><p><strong>Deadline:</strong> @(v.ApplicationDeadline?.ToString("dd MMM yyyy") ?? "None")</p><p><strong>Applications:</strong> @v.ApplicationCount</p></div></div><p class="mt-3">@v.Description</p><h3 class="h6">Requirements</h3><p>@v.Requirements</p><h3 class="h6">Responsibilities</h3><p>@v.Responsibilities</p></div><form asp-action="ApproveVacancy" asp-route-id="@v.Id" method="post" class="d-inline">@Html.AntiForgeryToken()<button class="btn btn-success" type="submit">Approve & publish</button></form><form asp-action="RejectVacancy" asp-route-id="@v.Id" method="post" class="d-inline"><input name="notes" class="form-control d-inline-block w-auto" placeholder="Rejection notes" />@Html.AntiForgeryToken()<button class="btn btn-danger" type="submit">Reject</button></form><form asp-action="RemoveVacancy" asp-route-id="@v.Id" method="post" class="d-inline"><input name="notes" class="form-control d-inline-block w-auto" placeholder="Removal notes" />@Html.AntiForgeryToken()<button class="btn btn-outline" type="submit">Remove</button></form></div></div>
