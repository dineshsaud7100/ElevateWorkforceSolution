@model AdminUsersViewModel
@{ ViewData["Title"] = "Users & roles"; }
<div class="page"><div class="container"><h1>Users & roles</h1><form method="get" asp-action="Users" class="row g-2 mb-3"><div class="col-md-4"><input asp-for="Keyword" class="form-control" placeholder="Search user" /></div><div class="col-md-3"><select asp-for="Role" asp-items="Model.RoleOptions" class="form-select"></select></div><div class="col-md-3"><select asp-for="ActiveOnly" class="form-select"><option value="true">Active only</option><option value="false">All users</option></select></div><div class="col-md-2"><button class="btn btn-outline w-100" type="submit">Filter</button></div></form>
@if(Model.Results.Items.Count==0){<div class="card"><div class="card-body text-muted">No users match these filters.</div></div>}{else{<div class="card table-wrap"><table class="table"><thead><tr><th>User</th><th>Role</th><th>Active</th><th>Verified</th><th>Created</th><th>Actions</th></tr></thead><tbody>@foreach(var u in Model.Results.Items){<tr><td><strong>@u.FullName</strong><div class="text-sm text-muted">@u.Email</div></td><td>@u.Role</td><td>@u.IsActive</td><td>@(u.Role == "Employer" ? u.IsVerified.ToString() : "—")</td><td>@u.CreatedDate.ToString("dd MMM yyyy")</td><td><form asp-action="ToggleUserActive" asp-route-userId="@u.UserId" method="post" class="d-inline">@Html.AntiForgeryToken()<button class="btn btn-outline btn-sm">@(u.IsActive?"Deactivate":"Activate")</button></form>@if(u.Role=="Employer"){<form asp-action="ToggleEmployerVerification" asp-route-userId="@u.UserId" method="post" class="d-inline">@Html.AntiForgeryToken()<button class="btn btn-outline btn-sm">@(u.IsVerified?"Unverify":"Verify")</button></form>}<form asp-action="ChangeUserRole" asp-route-userId="@u.UserId" method="post" class="d-inline">@Html.AntiForgeryToken()<select name="role" class="form-select d-inline-block">@foreach(var role in Model.RoleOptions){<option value="@role.Value" selected="@(role.Value==u.Role)">@role.Text</option>}</select><button class="btn btn-outline btn-sm">Save role</button></form></td></tr>}</tbody></table></div>}
</div></div>
