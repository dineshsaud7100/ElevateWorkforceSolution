@model AdminVacanciesViewModel
@{ ViewData["Title"] = "Vacancy moderation"; }
<div class="page"><div class="container"><h1>Vacancy moderation</h1><form method="get" asp-action="Vacancies" class="row g-2 mb-3"><div class="col-md-4"><input asp-for="Keyword" class="form-control" placeholder="Search vacancy" /></div><div class="col-md-3"><select asp-for="Status" asp-items="Model.StatusOptions" class="form-select"></select></div><div class="col-md-3"><input asp-for="Location" class="form-control" placeholder="Location" /></div><div class="col-md-2"><button class="btn btn-outline w-100" type="submit">Filter</button></div></form>
@if(Model.Results.Items.Count==0){<div class="card"><div class="card-body text-muted">No vacancies match these filters.</div></div>}{else{<div class="card table-wrap"><table class="table"><thead><tr><th>Vacancy</th><th>Company</th><th>Employer</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var v in Model.Results.Items){<tr><td><strong>@v.Title</strong><div class="text-sm text-muted">@v.WorkLocation · @v.Category</div></td><td>@v.CompanyName</td><td>@v.EmployerName</td><td><span class="badge @v.Status.CssClass()">@v.Status</span></td><td><a asp-action="ReviewVacancy" asp-route-id="@v.Id" class="btn btn-outline btn-sm">Review</a></td></tr>}</tbody></table></div>}
</div></div>
