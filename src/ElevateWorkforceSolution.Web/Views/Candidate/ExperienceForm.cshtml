@model ExperienceFormViewModel
@{
    ViewData["Title"] = "Add work experience";
}

<div class="page">
    <div class="container" style="max-width:640px">
        <div class="page-header">
            <h1>Add work experience</h1>
            <p>Include internships and voluntary work if they are relevant to the role.</p>
        </div>

        <div class="card card-pad">
            <form asp-controller="Candidate" asp-action="AddExperience" method="post" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="JobSeekerId" />
                <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                <div class="field-row field-row-2">
                    <div class="field">
                        <label asp-for="Position" class="form-label"></label>
                        <input asp-for="Position" class="form-control" placeholder="e.g. Software Engineer" />
                        <span asp-validation-for="Position" class="field-validation-error"></span>
                    </div>
                    <div class="field">
                        <label asp-for="CompanyName" class="form-label"></label>
                        <input asp-for="CompanyName" class="form-control" placeholder="e.g. F1Soft International" />
                        <span asp-validation-for="CompanyName" class="field-validation-error"></span>
                    </div>
                </div>

                <div class="field">
                    <label asp-for="Location" class="form-label"></label>
                    <input asp-for="Location" class="form-control" placeholder="e.g. Kathmandu" />
                </div>

                <div class="field-row field-row-2">
                    <div class="field">
                        <label asp-for="StartDate" class="form-label"></label>
                        <input asp-for="StartDate" class="form-control" type="date" />
                        <span asp-validation-for="StartDate" class="field-validation-error"></span>
                    </div>
                    <div class="field">
                        <label asp-for="EndDate" class="form-label"></label>
                        <input asp-for="EndDate" class="form-control" type="date" />
                        <span asp-validation-for="EndDate" class="field-validation-error"></span>
                    </div>
                </div>

                <div class="form-check">
                    <input asp-for="IsCurrent" class="form-check-input" id="isCurrent" />
                    <label asp-for="IsCurrent" class="form-check-label"></label>
                </div>

                <div class="field">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="4"
                              placeholder="What you did, what you built, what the outcome was."></textarea>
                </div>

                <div class="row">
                    <button type="submit" class="btn btn-primary">Save experience</button>
                    <a asp-controller="Candidate" asp-action="Profile" class="btn btn-outline">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var current = document.getElementById('isCurrent');
            var end = document.getElementById('EndDate');
            if (!current || !end) return;

            function sync() {
                end.disabled = current.checked;
                if (current.checked) end.value = '';
            }

            current.addEventListener('change', sync);
            sync();
        })();
    </script>
}
