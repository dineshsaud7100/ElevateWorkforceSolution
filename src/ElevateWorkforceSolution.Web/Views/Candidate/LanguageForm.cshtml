@model LanguageFormViewModel
@{
    ViewData["Title"] = "Add language";
}

<div class="page">
    <div class="container" style="max-width:520px">
        <div class="page-header">
            <h1>Add language</h1>
            <p>Tell employers which languages you can work in.</p>
        </div>

        <div class="card card-pad">
            <form asp-controller="Candidate" asp-action="AddLanguage" method="post" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="JobSeekerId" />
                <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                <div class="field">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" placeholder="e.g. Nepali" />
                    <span asp-validation-for="Name" class="field-validation-error"></span>
                </div>

                <div class="field">
                    <label asp-for="Proficiency" class="form-label"></label>
                    <select asp-for="Proficiency" asp-items="Model.ProficiencyOptions" class="form-select"></select>
                </div>

                <div class="row">
                    <button type="submit" class="btn btn-primary">Save language</button>
                    <a asp-controller="Candidate" asp-action="Profile" class="btn btn-outline">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
