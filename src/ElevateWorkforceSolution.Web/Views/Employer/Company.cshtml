@model EmployerCompanyViewModel
@{
    ViewData["Title"] = "Company profile";
    var company = Model.Company;
}

<div class="page"><div class="container">
<h1>Company profile</h1><p class="text-muted">Keep employer contact details and company information current.</p>
<form asp-action="Company" method="post">
    @Html.AntiForgeryToken()
    <div class="grid grid-2">
        <div class="card card-pad">
            <h2 class="h5">Company details</h2>
            <div class="field"><label asp-for="Form.Name" class="form-label"></label><input asp-for="Form.Name" class="form-control" /></div>
            <div class="field"><label asp-for="Form.Industry" class="form-label"></label><input asp-for="Form.Industry" class="form-control" /></div>
            <div class="field"><label asp-for="Form.Location" class="form-label"></label><input asp-for="Form.Location" class="form-control" /></div>
            <div class="field"><label asp-for="Form.Website" class="form-label"></label><input asp-for="Form.Website" class="form-control" /></div>
            <div class="field"><label asp-for="Form.CompanySize" class="form-label"></label><input asp-for="Form.CompanySize" class="form-control" /></div>
            <div class="field"><label asp-for="Form.FoundedYear" class="form-label"></label><input asp-for="Form.FoundedYear" class="form-control" /></div>
        </div>
        <div class="card card-pad">
            <h2 class="h5">Contact & overview</h2>
            <div class="field"><label asp-for="Form.ContactEmail" class="form-label"></label><input asp-for="Form.ContactEmail" class="form-control" /></div>
            <div class="field"><label asp-for="Form.ContactPhone" class="form-label"></label><input asp-for="Form.ContactPhone" class="form-control" /></div>
            <div class="field"><label asp-for="Form.Description" class="form-label"></label><textarea asp-for="Form.Description" class="form-control" rows="4"></textarea></div>
            <div class="field"><label asp-for="Form.About" class="form-label"></label><textarea asp-for="Form.About" class="form-control" rows="4"></textarea></div>
        </div>
    </div>
    <button class="btn btn-primary mt-3" type="submit">Save company profile</button>
</form>
@if (company is not null) { <p class="text-muted mt-3">Profile saved for @company.Name.</p> }
</div></div>
