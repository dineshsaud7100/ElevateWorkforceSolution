@model VacancyFormViewModel
@{
    ViewData["Title"] = Model.Form.Id.HasValue ? "Edit vacancy" : "Post vacancy";
}

<div class="page"><div class="container"><h1>@ViewData["Title"]</h1><form asp-action="SaveVacancy" method="post"><input type="hidden" asp-for="Form.Id" />@Html.AntiForgeryToken()
<div class="grid grid-2 gap-3">
<div class="card card-pad"><div class="field"><label asp-for="Form.Title" class="form-label"></label><input asp-for="Form.Title" class="form-control" /></div><div class="field"><label asp-for="Form.Category" class="form-label"></label><input asp-for="Form.Category" class="form-control" list="category-options" /><datalist id="category-options">@foreach(var item in Model.CategoryOptions){<option value="@item.Value"></option>}</datalist></div><div class="field"><label asp-for="Form.WorkLocation" class="form-label"></label><input asp-for="Form.WorkLocation" class="form-control" list="location-options" /><datalist id="location-options">@foreach(var item in Model.LocationOptions){<option value="@item.Value"></option>}</datalist></div><div class="field"><label asp-for="Form.Headcount" class="form-label"></label><input asp-for="Form.Headcount" class="form-control" /></div><div class="field"><label asp-for="Form.ApplicationDeadline" class="form-label"></label><input asp-for="Form.ApplicationDeadline" class="form-control" /></div></div>
<div class="card card-pad"><div class="row g-2"><div class="col"><label asp-for="Form.JobType" class="form-label"></label><select asp-for="Form.JobType" asp-items="Model.JobTypeOptions" class="form-select"></select></div><div class="col"><label asp-for="Form.WorkArrangement" class="form-label"></label><select asp-for="Form.WorkArrangement" asp-items="Model.WorkArrangementOptions" class="form-select"></select></div><div class="col"><label asp-for="Form.ExperienceLevel" class="form-label"></label><select asp-for="Form.ExperienceLevel" asp-items="Model.ExperienceLevelOptions" class="form-select"></select></div><div class="col"><label asp-for="Form.SalaryMin" class="form-label"></label><input asp-for="Form.SalaryMin" class="form-control" /></div><div class="col"><label asp-for="Form.SalaryMax" class="form-label"></label><input asp-for="Form.SalaryMax" class="form-control" /></div></div><div class="field"><label asp-for="Form.Skills" class="form-label"></label><input asp-for="Form.Skills" class="form-control" placeholder="Comma-separated skill names" /></div><div class="field"><label asp-for="Form.Description" class="form-label"></label><textarea asp-for="Form.Description" class="form-control" rows="4"></textarea></div></div>
</div><div class="card card-pad mt-3"><div class="field"><label asp-for="Form.Responsibilities" class="form-label"></label><textarea asp-for="Form.Responsibilities" class="form-control" rows="4"></textarea></div><div class="field"><label asp-for="Form.Requirements" class="form-label"></label><textarea asp-for="Form.Requirements" class="form-control" rows="4"></textarea></div><div class="field"><label asp-for="Form.Benefits" class="form-label"></label><textarea asp-for="Form.Benefits" class="form-control" rows="4"></textarea></div></div>
<button type="submit" class="btn btn-primary mt-3">Save vacancy</button></form></div></div>
