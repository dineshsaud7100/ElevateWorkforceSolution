@model (string Icon, string Title, string Message, string? ActionUrl, string? ActionText)
<div class="empty-state">
    <span class="empty-state-icon" aria-hidden="true">@Model.Icon</span>
    <h3>@Model.Title</h3>
    <p>@Model.Message</p>
    @if (!string.IsNullOrWhiteSpace(Model.ActionUrl) && !string.IsNullOrWhiteSpace(Model.ActionText))
    {
        <a href="@Model.ActionUrl" class="btn btn-primary mt-3">@Model.ActionText</a>
    }
</div>
